# docker-compose settings. Copy to .env and fill in.
SECRET_KEY=generate-a-long-random-string-at-least-32-chars
POSTGRES_PASSWORD=generate-another-random-string

# What this server runs:
#   whole app (website + API):   COMPOSE_PROFILES=web   WEB_MODE=proxy
#   API only (website elsewhere, e.g. Vercel; see deploy/oracle/README.md):
#                                COMPOSE_PROFILES=      WEB_MODE=redirect   PUBLIC_BASE_URL=https://<api address>
COMPOSE_PROFILES=web
WEB_MODE=proxy
PUBLIC_BASE_URL=
BACKUP_KEEP_DAYS=14
# Venue marketplace: max venue video size (MB) and length (seconds).
# VENUE_VIDEO_MAX_MB=100
# VENUE_VIDEO_MAX_SECONDS=60

# Object storage and encrypted off-server backups (any S3-compatible service; guide:
# deploy/oracle/README.md step 10). STORAGE_BACKEND=local keeps uploads on the server's disk.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
BACKUP_S3_BUCKET=
# Keep a copy in a password manager: off-server backups can't be decrypted without it.
BACKUP_PASSPHRASE=
OFFSITE_KEEP_DAYS=30
# Activity tracking for recommendations: rows older than this many days are deleted daily
# (docs/recommendations-spec.md). Say the same number in the Privacy Policy.
ACTIVITY_RETENTION_DAYS=180
# Rain forecasts for the feed (api.open-meteo.com, no key); event text embeddings
# (auto | openai | gemini | hashing | off); an optional trained ranker file.
WEATHER_ENABLED=true
EMBEDDINGS_PROVIDER=auto
RANKER_MODEL_PATH=

# Public address. With a domain, Caddy fetches an HTTPS certificate automatically:
#   SITE_ADDRESS=turnup.example.com
#   FRONTEND_URL=https://turnup.example.com
#   ALLOWED_ORIGINS=https://turnup.example.com
SITE_ADDRESS=:80
FRONTEND_URL=http://localhost
ALLOWED_ORIGINS=http://localhost

# Payments (required for paid tickets outside debug mode)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Email (set EMAIL_CONSOLE=true to print emails to the logs instead of sending)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@turnup.app

# Optional: OAuth, SMS, AI drafting
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
