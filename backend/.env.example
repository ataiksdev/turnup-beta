DATABASE_URL=sqlite+aiosqlite:///./data/turnup.db
SECRET_KEY=change-me-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEBUG=true

# AI event-drafting agent (admin/moderator portal + daily scout agent).
# Set AI_PROVIDER to whichever one you have a key for; only that provider's key is required.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
