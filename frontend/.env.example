# Web dev: leave NEXT_PUBLIC_API_URL unset to call /api/* on this server, which proxies to
# API_PROXY_ORIGIN (default http://localhost:8000). No CORS setup needed.
# NEXT_PUBLIC_API_URL=http://localhost:8000
# API_PROXY_ORIGIN=http://localhost:8000

# Public address of the website, used for share/invite links and link previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown in the Privacy Policy (/privacy) for data requests. Set it before going live.
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@turnup.ng

# ── Capacitor (Android) build: `npm run build:capacitor` ──
# The app has no proxy, so it must call the API directly (and the backend's ALLOWED_ORIGINS
# must include http://localhost, the app's WebView origin):
#   NEXT_PUBLIC_API_URL=https://api.your-domain.example
#   NEXT_PUBLIC_SITE_URL=https://your-domain.example
#
# Point the app at a live Next dev server for hot reload instead of the bundled export.
# Leave unset to use the bundled build.
# CAPACITOR_DEV_SERVER_URL=http://<your-lan-ip>:3003
